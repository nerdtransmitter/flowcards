{
  "name": "Task",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "description": "Task title"
    },
    "notes": {
      "type": "string",
      "description": "Markdown notes and details"
    },
    "why": {
      "type": "string",
      "description": "One-line purpose - why this matters"
    },
    "next_step": {
      "type": "string",
      "description": "Suggested next step (≤120 chars)"
    },
    "project_id": {
      "type": "string",
      "description": "Associated project ID"
    },
    "deadline_type": {
      "type": "string",
      "enum": [
        "none",
        "soft",
        "hard"
      ],
      "default": "none",
      "description": "Deadline flexibility"
    },
    "aim_by": {
      "type": "string",
      "format": "date",
      "description": "Optional target date"
    },
    "effort": {
      "type": "string",
      "enum": [
        "tiny",
        "small",
        "medium",
        "large"
      ],
      "default": "small",
      "description": "Estimated effort"
    },
    "energy": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high"
      ],
      "description": "Energy level required"
    },
    "context_tags": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "home",
          "errands",
          "laptop",
          "phone",
          "quiet",
          "15min",
          "30min",
          "60min",
          "deep_work"
        ]
      },
      "description": "Context tags for filtering"
    },
    "source": {
      "type": "string",
      "enum": [
        "inbox",
        "quick",
        "import",
        "voice",
        "chat"
      ],
      "default": "inbox"
    },
    "surfaced_count": {
      "type": "integer",
      "default": 0,
      "description": "Times shown in Focus Now"
    },
    "snoozed_until": {
      "type": "string",
      "format": "date-time",
      "description": "Snoozed until this datetime"
    },
    "links": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Related URLs"
    },
    "blocked_by": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Task IDs blocking this one"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "waiting",
        "done",
        "archived"
      ],
      "default": "active"
    },
    "is_pinned": {
      "type": "boolean",
      "default": false,
      "description": "Prevent auto-decay"
    },
    "is_important": {
      "type": "boolean",
      "default": false,
      "description": "Send both SMS and push"
    },
    "completed_at": {
      "type": "string",
      "format": "date-time"
    },
    "emoji": {
      "type": "string",
      "description": "Optional emoji icon"
    }
  },
  "required": [
    "title"
  ],
  "rls": {
    "create": {
      "created_by": "{{user.email}}"
    },
    "update": {
      "created_by": "{{user.email}}"
    },
    "delete": {
      "created_by": "{{user.email}}"
    },
    "read": {
      "created_by": "{{user.email}}"
    },
    "write": {
      "created_by": "{{user.email}}"
    }
  }
}